# ==============================================================================
# Email Delivery Provider Configuration (MR-1A)
# IMPORTANT: SYNTHETIC DATA ONLY. LIVE CUSTOMER MESSAGING REMAINS DISABLED.
#
# Safe default is ConsoleEmailProvider (EMAIL_PROVIDER=console).
# Resend sending requires ALL FOUR conditions to be satisfied:
# 1. EMAIL_PROVIDER=resend
# 2. RESEND_API_KEY=<valid_api_key>
# 3. EMAIL_FROM_ADDRESS=<configured_sender@domain.com>
# 4. ENABLE_LIVE_EMAIL=true (explicit authorization switch)
# Without ENABLE_LIVE_EMAIL=true, ConsoleEmailProvider is strictly used.
#
# Dedicated Synthetic Hosted Validation Mode (MR-1B-H):
# ENABLE_SYNTHETIC_EMAIL_VALIDATION=false
# - Development / ordinary hosted state = false (ConsoleEmailProvider)
# - Synthetic hosted Resend validation = true (enables Resend provider in test-only mode)
# - Synthetic validation permits ONLY the three hard-coded Resend test recipients:
#     delivered@resend.dev
#     bounced@resend.dev
#     complained@resend.dev
# - Real customer messaging still requires ENABLE_LIVE_EMAIL=true
# ==============================================================================
EMAIL_PROVIDER=console
ENABLE_LIVE_EMAIL=false
ENABLE_SYNTHETIC_EMAIL_VALIDATION=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
RESEND_WEBHOOK_SECRET=

# Inngest Workflow Orchestration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
