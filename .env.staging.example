# MPG Reputation — Controlled Staging Environment Configuration
# Synthetic Data Only — Live Customer Messaging Disabled

# 1. Hosted Supabase Staging Project
# Create a dedicated staging project in Supabase (e.g. "mpg-reputation-staging")
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-STAGING-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-STAGING-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-STAGING-SERVICE-ROLE-KEY]

# 2. Vercel Staging Application URL
# Must match the Vercel staging URL (used for auth redirects and tracked links)
NEXT_PUBLIC_APP_URL=https://[YOUR-VERCEL-DEPLOYMENT].vercel.app

# 3. Email Delivery Mode (FROZEN FOR V0.2)
# Strictly console provider for controlled staging; live customer emails disabled
EMAIL_PROVIDER=console
ENABLE_LIVE_EMAIL=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=

# 4. Inngest Cloud Staging Environment
# Generated from Inngest Cloud dashboard -> Environments -> Staging
INNGEST_EVENT_KEY=[YOUR-INNGEST-EVENT-KEY]
INNGEST_SIGNING_KEY=[YOUR-INNGEST-SIGNING-KEY]
